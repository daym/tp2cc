Author: Danny Milosavljevic <dannym@friendly-machines.com>
Date: 2026-05-11
Subject: Use a dynamic array for spills
License: expat

`Tspill_temp_list = array[tsuperregister] of Treference` declares a
static array spanning the full superregister range. `trgobj.spill_registers`
allocates only `sizeof(treference)*maxreg` bytes and treats that as a
pointer to the static-typed array, indexing within `[0..maxreg-1]`.
Native FPC happens not to crash because it passes `const spilltemplist`
by hidden reference and does not copy the full static array from the
under-allocated buffer.  That is a calling-convention accident, not a
property the source can rely on.

Switch the type to `array of Treference` (dynamic array, carried as
length and pointer) and use `SetLength` / `:=nil` instead of `allocmem` /
`freemem`.

The JVM backend's `rgcpu.pas` uses the same `^Tspill_temp_list`
`allocmem` / `freemem` idiom on top of the same type; also fix it.

--- a/compiler/rgobj.pas
+++ b/compiler/rgobj.pas
@@ -116,7 +116,7 @@ unit rgobj;
       end;
       tspillregsinfo = array[0..3] of tspillreginfo;

-      Tspill_temp_list=array[tsuperregister] of Treference;
+      Tspill_temp_list=array of Treference;

       {#------------------------------------------------------------------

@@ -1903,7 +1903,7 @@ unit rgobj;
         t : tsuperregister;
         p,q : Tai;
         regs_to_spill_set:Tsuperregisterset;
-        spill_temps : ^Tspill_temp_list;
+        spill_temps : Tspill_temp_list;
         supreg : tsuperregister;
         templist : TAsmList;
         size: ptrint;
@@ -1912,7 +1912,7 @@ unit rgobj;
         live_registers.clear;
         for i:=first_imaginary to maxreg-1 do
           exclude(reginfo[i].flags,ri_selected);
-        spill_temps:=allocmem(sizeof(treference)*maxreg);
+        SetLength(spill_temps,maxreg);
         supregset_reset(regs_to_spill_set,false,$ffff);
         { Allocate temps and insert in front of the list }
         templist:=TAsmList.create;
@@ -1937,7 +1937,7 @@ unit rgobj;
                 size:=tcgsize2size[reg_cgsize(newreg(regtype,t,reginfo[t].subreg))];
               tg.gettemp(templist,
                          size,size,
-                         tt_noreuse,spill_temps^[t]);
+                         tt_noreuse,spill_temps[t]);
             end;
         list.insertlistafter(headertai,templist);
         templist.free;
@@ -1978,7 +1978,7 @@ unit rgobj;
                   begin
 //                    writeln(gas_op2str[taicpu(p).opcode]);
                     current_filepos:=fileinfo;
-                    if instr_spill_register(list,taicpu(p),regs_to_spill_set,spill_temps^) then
+                    if instr_spill_register(list,taicpu(p),regs_to_spill_set,spill_temps) then
                       spill_registers:=true;
                   end;
             end;
@@ -1988,8 +1988,8 @@ unit rgobj;
         {Safe: this procedure is only called if there are spilled nodes.}
         with spillednodes do
           for i:=0 to length-1 do
-            tg.ungettemp(list,spill_temps^[buf^[i]]);
-        freemem(spill_temps);
+            tg.ungettemp(list,spill_temps[buf^[i]]);
+        spill_temps:=nil;
       end;


--- a/compiler/jvm/rgcpu.pas
+++ b/compiler/jvm/rgcpu.pas
@@ -32,7 +32,7 @@ unit rgcpu;
       rgobj;

     type
-      tspilltemps = array[tregistertype] of ^Tspill_temp_list;
+      tspilltemps = array[tregistertype] of Tspill_temp_list;

       { trgcpu }

@@ -295,8 +295,8 @@ unit rgcpu;
         { remove some simple useless store/load sequences }
         remove_dummy_load_stores(list,headertai);
         { allocate room to store the virtual register -> temp mapping }
-        spill_temps[R_INTREGISTER]:=allocmem(sizeof(treference)*intrg.maxreg);
-        spill_temps[R_FPUREGISTER]:=allocmem(sizeof(treference)*fprg.maxreg);
+        SetLength(spill_temps[R_INTREGISTER],intrg.maxreg);
+        SetLength(spill_temps[R_FPUREGISTER],fprg.maxreg);
         { List to insert temp allocations into }
         templist:=TAsmList.create;
         { allocate/replace all registers }
@@ -327,10 +327,10 @@ unit rgcpu;
                       ra_alloc :
                         tg.gettemp(templist,
                                    size,1,
-                                   tt_regallocator,spill_temps[getregtype(reg)]^[getsupreg(reg)]);
+                                   tt_regallocator,spill_temps[getregtype(reg)][getsupreg(reg)]);
                       ra_dealloc :
                         begin
-                          tg.ungettemp(templist,spill_temps[getregtype(reg)]^[getsupreg(reg)]);
+                          tg.ungettemp(templist,spill_temps[getregtype(reg)][getsupreg(reg)]);
                           { don't invalidate the temp reference, may still be used one instruction
                             later }
                         end;
@@ -350,8 +350,8 @@ unit rgcpu;
             end;
             p:=Tai(p.next);
           end;
-        freemem(spill_temps[R_INTREGISTER]);
-        freemem(spill_temps[R_FPUREGISTER]);
+        spill_temps[R_INTREGISTER]:=nil;
+        spill_temps[R_FPUREGISTER]:=nil;
         templist.free;
       end;

