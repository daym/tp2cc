Author: Danny Milosavljevic <dannym@friendly-machines.com>
Date: 2026-05-31
Subject: Use ordinary SizeOf for pointer-width branches
License: expat

FPC 3.2.0 uses {$if sizeof(...)} inside compiler implementation code to choose pointer-sized and host-sized executable branches.  These decisions are ordinary Pascal code decisions, so keep both branches visible to the parser and use normal SizeOf tests at runtime.

--- a/compiler/hlcgobj.pas
+++ b/compiler/hlcgobj.pas
@@ -3623,11 +3623,9 @@
         maxdef:=fromdef
       else
         maxdef:=todef;
-{$if sizeof(aintmax) = 8}
-      if maxdef.size=8 then
+      if (sizeof(aintmax) = 8) and (maxdef.size=8) then
         aintmax:=high(int64)
       else
-{$endif}
         begin
           aintmax:=high(longint);
           maxdef:=u32inttype;
--- a/compiler/entfile.pas
+++ b/compiler/entfile.pas
@@ -852,11 +852,10 @@
     result:=getqword
   else result:=getdword;
 {$else not generic_cpu}
-  {$if sizeof(TConstPtrUInt)=8}
-  result:=tconstptruint(getint64);
-  {$else}
-  result:=TConstPtrUInt(getlongint);
-  {$endif}
+  if sizeof(TConstPtrUInt)=8 then
+    result:=tconstptruint(getint64)
+  else
+    result:=TConstPtrUInt(getlongint);
 {$endif not generic_cpu}
 end;
 
@@ -1272,11 +1271,10 @@
 
 procedure tentryfile.putptruint(v:TConstPtrUInt);
 begin
-  {$if sizeof(TConstPtrUInt)=8}
-  putint64(int64(v));
-  {$else}
-  putlongint(longint(v));
-  {$endif}
+  if sizeof(TConstPtrUInt)=8 then
+    putint64(int64(v))
+  else
+    putlongint(longint(v));
 end;
 
 
