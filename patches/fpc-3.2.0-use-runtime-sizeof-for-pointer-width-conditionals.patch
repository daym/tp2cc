Author: Danny Milosavljevic <dannym@friendly-machines.com>
Date: 2026-05-31
Subject: Type hlcgobj range checks after SizeOf lowering
License: expat

FPC 3.2.0 uses a preprocessor SizeOf test in hlcgobj.pas to pick the integer
type used for range-check constants.  Once that test is ordinary Pascal code,
the i386 bootstrap must still type-check the 64-bit arm of the branch.

Keep aintmax in the TCGInt domain consumed by a_cmp_const_reg_label and test
the original pointer-width condition explicitly.  Suppress only the diagnostic
for the inactive host-width branch.

--- a/compiler/hlcgobj.pas
+++ b/compiler/hlcgobj.pas
@@ -3491,11 +3491,7 @@
 
   procedure thlcgobj.g_rangecheck(list: TAsmList; const l: tlocation; fromdef, todef: tdef);
     var
-{$if defined(cpu64bitalu) or defined(cpu32bitalu)}
-      aintmax: aint;
-{$else}
-      aintmax: longint;
-{$endif}
+      aintmax: TCGInt;
       neglabel : tasmlabel;
       hreg : tregister;
       lto,hto,
@@ -3623,15 +3619,15 @@
         maxdef:=fromdef
       else
         maxdef:=todef;
-{$if sizeof(aintmax) = 8}
-      if maxdef.size=8 then
+      {$push}{$warn 6018 off} { The inactive range-check width arm is unreachable on each host. }
+      if (sizeof(aint) = 8) and (maxdef.size=8) then
         aintmax:=high(int64)
       else
-{$endif}
         begin
           aintmax:=high(longint);
           maxdef:=u32inttype;
         end;
+      {$pop}
 
       { generate the rangecheck code for the def where we are going to }
       { store the result                                               }
