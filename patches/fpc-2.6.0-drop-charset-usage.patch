@@ -61,9 +61,6 @@
   implementation
 
     uses
-      cp8859_1,cp850,cp437,
-      { cyrillic code pages }
-      cp1251,cp866,cp8859_5,
       globals,cutils;
 
 
@@ -160,16 +157,9 @@
       end;
 
