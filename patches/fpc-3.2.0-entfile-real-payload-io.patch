        end;
-      readdata(e,sizeof(e));
+      fillchar(e,sizeof(e),0);
+      readdata(e,payload_size);
       if change_endian then
         result:=swapendian_entryreal(e)
       else
         result:=e;
-      inc(entryidx,sizeof(e));
+      inc(entryidx,payload_size);
       exit;
     end;
   if sizeofreal=sizeof(d) then
@@ -970,7 +990,7 @@
     end
   else
     begin
-      d:=getrealsize(sizeof(d));
+      d:=getrealsize(entryreal_payload_size);
       getreal:=d;
     end;
 end;
@@ -1272,11 +1292,12 @@
 
