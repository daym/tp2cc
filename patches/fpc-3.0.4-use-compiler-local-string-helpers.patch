Author: Danny Milosavljevic <dannym@friendly-machines.com>
Date: 2026-05-10
Subject: Use compiler-local string helpers in the bootstrap compiler
License: expat

Replace those calls with compiler-local helpers or direct Pascal operations.
--- a/compiler/scandir.pas
+++ b/compiler/scandir.pas
@@ -870,7 +870,7 @@
                 current_scanner.readstring;
                 s:=s+'.'+orgpattern;
               end;
-            disposestr(current_module.namespace);
+            stringdispose(current_module.namespace);
             current_module.namespace:=stringdup(s);
           end;
       end;
--- a/compiler/cfileutl.pas
+++ b/compiler/cfileutl.pas
@@ -714,9 +714,7 @@
         i, L : longint;
         P: PChar;
       begin
-        Result := s;
-        { make result unique since we're going to change it via a pchar }
-        uniquestring(result);
+        Result := copy(s,1,length(s));
         L := Length(Result);
         if L=0 then
           exit;
