+                                            { search_class_member returns an arbitrary psym.
+                                              Reinterpreting it as pvarsym was wrong for
+                                              every other subtype. Dropped. }
+                                            sym:=search_class_member(pobjectdef(pd),pattern);
                                             if not assigned(sym) then
                                               Message1(sym_e_id_no_member,pattern)
                                             else if not(getaddr) and not(sp_static in sym^.symoptions) then
