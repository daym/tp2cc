-                                                 sym:=pvarsym(srsymtable^.search(pattern));
+                                                 { Symtable search returns an arbitrary psym
+                                                   (procsym, typesym, varsym, ...). The old
+                                                   `pvarsym(..)' wrap reinterpreted whatever
+                                                   came back as a tvarsym -- wrong: those are
+                                                   unrelated records. Dropped; nothing below
+                                                   reads varsym-specific fields. }
+                                                 sym:=srsymtable^.search(pattern);
                                                  if assigned(sym) then
                                                   break;
                                                  pd:=pobjectdef(pd)^.childof;
@@ -1073,7 +1089,10 @@
