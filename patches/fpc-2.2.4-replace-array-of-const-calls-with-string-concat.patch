Author: Danny Milosavljevic <dannym@friendly-machines.com>
Date: 2026-04-27
Subject: Replace SysUtils.Format and Exception.CreateFmt calls with string concat
License: expat

The bootstrap reaches `array of const` parameters in two places: the
FPC_FULLVERSION `Format` call in options.pas and two
`EListError.CreateFmt(Msg, [Data])` calls in cclasses.pas. Avoid
adding `array of const` lowering plus rt Format/CreateFmt helpers --
just rewrite both shapes as string concatenation.

The Format result is byte-identical for single-digit version
components (zero-pad helper). CreateFmt loses `%d` substitution and
appends the value as a trailing `(N)`; the helpers are only reached
on bad list indices.

--- a/compiler/options.pas
+++ b/compiler/options.pas
@@ -91,6 +91,15 @@
   ppcaltcfg,
   param_file    : string;   { file to compile specified on the commandline }
 
+{ Two-digit zero-padded `tostr` -- the bootstrap path replaces a single
+  SysUtils.Format('%d%.02d%.02d', ...) call with string concatenation so
+  the rt subset does not need `Format` plus full `array of const`. }
+function tp2cc_pad2(v : longint) : string;
+begin
+  if v < 10 then tp2cc_pad2 := '0' + tostr(v)
+  else tp2cc_pad2 := tostr(v);
+end;
+
 {****************************************************************************
                                  Defines
 ****************************************************************************}
@@ -2537,7 +2546,10 @@
   set_system_macro('FPC_VERSION',version_nr);
   set_system_macro('FPC_RELEASE',release_nr);
   set_system_macro('FPC_PATCH',patch_nr);
-  set_system_macro('FPC_FULLVERSION',Format('%d%.02d%.02d',[StrToInt(version_nr),StrToInt(release_nr),StrToInt(patch_nr)]));
+  set_system_macro('FPC_FULLVERSION',
+                   tostr(StrToInt(version_nr)) +
+                   tp2cc_pad2(StrToInt(release_nr)) +
+                   tp2cc_pad2(StrToInt(patch_nr)));
 
   for i:=low(tfeature) to high(tfeature) do
     if i in features then
--- a/compiler/cclasses.pas
+++ b/compiler/cclasses.pas
@@ -605,7 +605,7 @@
 
 class procedure TFPList.Error(const Msg: string; Data: PtrInt);
 begin
-  Raise EListError.CreateFmt(Msg,[Data]) at get_caller_addr(get_frame);
+  Raise EListError.Create(Msg + ' (' + tostr(Data) + ')') at get_caller_addr(get_frame);
 end;
 
 procedure TFPList.Exchange(Index1, Index2: Integer);
@@ -1257,7 +1257,7 @@
 
 class procedure TFPHashList.Error(const Msg: string; Data: PtrInt);
 begin
-  Raise EListError.CreateFmt(Msg,[Data]) at get_caller_addr(get_frame);
+  Raise EListError.Create(Msg + ' (' + tostr(Data) + ')') at get_caller_addr(get_frame);
 end;
 
 function TFPHashList.Expand: TFPHashList;
