Author: Danny Milosavljevic <dannym@friendly-machines.com>
Date: 2026-05-09
Subject: Use ordinary SizeOf for pointer-width branches
License: expat

FPC 3.0.4 uses {$if sizeof(...)} inside compiler implementation code to
choose pointer-sized and host-sized executable branches.  These decisions are
ordinary Pascal code decisions, so keep both branches visible to the parser
and use normal SizeOf tests at runtime.

--- a/compiler/hlcgobj.pas
+++ b/compiler/hlcgobj.pas
@@ -3411,11 +3411,9 @@
         maxdef:=fromdef
       else
         maxdef:=todef;
-{$if sizeof(aintmax) = 8}
-      if maxdef.size=8 then
+      if (sizeof(aintmax) = 8) and (maxdef.size=8) then
         aintmax:=high(int64)
       else
-{$endif}
         begin
           aintmax:=high(longint);
           maxdef:=u32inttype;
--- a/compiler/ncnv.pas
+++ b/compiler/ncnv.pas
@@ -939,19 +939,23 @@
         if left.nodetype=ordconstn then
           begin
             { check if we have a valid pointer constant (JM) }
-            {$if sizeof(pointer) > sizeof(TConstPtrUInt)}
-              {$if sizeof(TConstPtrUInt) = 4}
-                  if (tordconstnode(left).value < int64(low(longint))) or
-                     (tordconstnode(left).value > int64(high(cardinal))) then
-                  CGMessage(parser_e_range_check_error);
-              {$else} {$if sizeof(TConstPtrUInt) = 8}
-                  if (tordconstnode(left).value < int64(low(int64))) or
-                     (tordconstnode(left).value > int64(high(qword))) then
-                  CGMessage(parser_e_range_check_error);
-              {$else}
-                internalerror(2001020801);
-              {$endif} {$endif}
-            {$endif}
+            if sizeof(pointer) > sizeof(TConstPtrUInt) then
+              begin
+                if sizeof(TConstPtrUInt) = 4 then
+                  begin
+                    if (tordconstnode(left).value < int64(low(longint))) or
+                       (tordconstnode(left).value > int64(high(cardinal))) then
+                      CGMessage(parser_e_range_check_error);
+                  end
+                else if sizeof(TConstPtrUInt) = 8 then
+                  begin
+                    if (tordconstnode(left).value < int64(low(int64))) or
+                       (tordconstnode(left).value > int64(high(qword))) then
+                      CGMessage(parser_e_range_check_error);
+                  end
+                else
+                  internalerror(2001020801);
+              end;
 
             if not(nf_explicit in flags) then
               if (tordconstnode(left).value.svalue=0) then
--- a/compiler/ngtcon.pas
+++ b/compiler/ngtcon.pas
