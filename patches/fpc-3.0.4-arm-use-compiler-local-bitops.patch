+
+    function arm_bsf_dword(const value : dword) : cardinal;
+      var
+        v : dword;
+      begin
+        if value=0 then
+          begin
+            result:=$ff;
+            exit;
+          end;
+
+        result:=0;
+        v:=value;
+        while (v and 1)=0 do
+          begin
+            v:=v shr 1;
+            inc(result);
+          end;
+      end;
+
+    function arm_bsr_dword(const value : dword) : cardinal;
+      var
+        mask : dword;
+      begin
+        if value=0 then
+          begin
+            result:=$ff;
+            exit;
+          end;
+
+        result:=31;
+        mask:=$80000000;
+        while (value and mask)=0 do
+          begin
+            mask:=mask shr 1;
+            dec(result);
+          end;
+      end;
+
+    function arm_sar_longint(const value : longint; const shift : byte) : longint;
+      var
+        s : byte;
+      begin
+        s:=shift and 31;
+        if s=0 then
+          result:=value
+        else if value<0 then
+          result:=longint((dword(value) shr s) or (not(dword(0)) shl (32-s)))
+        else
+          result:=longint(dword(value) shr s);
+      end;
+
     function is_continuous_mask(d : aint;var lsb, width: byte) : boolean;
       var
         msb : byte;
       begin
-        lsb:=BsfDword(d);
-        msb:=BsrDword(d);
+        lsb:=arm_bsf_dword(d);
+        msb:=arm_bsr_dword(d);
         
         width:=msb-lsb+1;
         
