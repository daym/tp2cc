         'OR','XOR');
 
-      token2str : array[tasmtoken] of string[10] = (
+      token2str : array[AS_NONE..AS_XOR] of string[10] = (
         '','Label','LLabel','String','Integer',
         ',','[',']','(',
         ')',':','.','+','-','*',
